{
  "name": "client",
  "version": "0.1.0-beta",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run copy:pdfjs",
    "dev": "vite",
    "prebuild": "npm run copy:pdfjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:graph-wasm": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo build --release --target wasm32-unknown-unknown --manifest-path graph-wasm/Cargo.toml && cp graph-wasm/target/wasm32-unknown-unknown/release/graph_wasm.wasm src/canvas/graph-eval.wasm",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hocuspocus/provider": "^4.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tldraw/state": "^5.4.0",
    "@whiteboard/shared": "*",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fractional-indexing": "^3.2.0",
    "lucide-react": "^1.18.0",
    "mathjax-full": "^3.2.2",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "pdfjs-dist": "^6.3.289",
    "rbush": "^4.0.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.14.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
