{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/purity": "off",
    "react/globals": "off",
    "react/use-memo": "off"
  },
  "ignorePatterns": ["**/dist/**"]
}
