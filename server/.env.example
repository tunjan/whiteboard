# The only account: the tutor. Plaintext password, compared in constant time.
TUTOR_PASSWORD=changeme

# Secret used to sign the session cookie/JWT. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Display name shown for the tutor's presence/cursor.
TUTOR_NAME=Tutor

# Postgres connection (matches docker-compose.yml).
DATABASE_URL=postgres://whiteboard:whiteboard@localhost:5433/whiteboard

# HTTP + collaboration server port.
PORT=3001

# Directory for uploaded image blobs (content-addressed). Relative to the
# server's working directory.
BLOB_DIR=data/blobs

# Directory for local music files. First-level folders become playlists.
MUSIC_DIR=data/music
