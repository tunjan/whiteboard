# The first account, made on first boot when there are no accounts yet. On a
# self-hosted server it is the only one, and the login screen asks for this
# password alone. Changing it here later does nothing: use
# `npm run tutor:password -w server -- <email>` instead.
TUTOR_PASSWORD=changeme
# Its sign-in name, if you open sign-ups and need an email-style login.
# TUTOR_EMAIL=tutor

# Secret used to sign the session cookie/JWT. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Display name shown for the tutor's presence/cursor.
TUTOR_NAME=Tutor

# Postgres connection (matches docker-compose.yml).
DATABASE_URL=postgres://whiteboard:whiteboard@localhost:5433/whiteboard

# HTTP + collaboration server port.
PORT=3001

# Directory for uploaded image blobs (content-addressed). Relative to the
# server's working directory.
BLOB_DIR=data/blobs

# Directory for local music files. First-level folders become playlists.
MUSIC_DIR=data/music

# OpenRouter key for the AI equation actions: transcribing handwriting into
# LaTeX, and writing a formula from a description ("quadratic formula").
# Leave unset to turn both off — the buttons then don't render at all.
OPENROUTER_API_KEY=

# Models used for those two actions.
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash

# Speech-to-text for dictating an equation description aloud.
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo

# Header your proxy writes the real client IP into, so rate limits apply per
# client rather than to everyone at once: `cf-connecting-ip` behind Cloudflare
# (including a tunnel), `x-forwarded-for` behind most others. Only set this if
# the server can't be reached except through that proxy — otherwise clients
# can pick their own IP.
# CLIENT_IP_HEADER=cf-connecting-ip

# Disk the open image/document uploads may use in total, in GB (default 20).
# UPLOAD_QUOTA_GB=20

# Where this deployment's source code is published. The app's "Source code"
# link goes here; if you run a modified copy for others, the AGPL requires
# that it point at your modified source.
# SOURCE_URL=https://github.com/tunjan/whiteboard

# Public demo at /demo: a board anyone can draw on without signing in,
# replaced with a fresh one every DEMO_RESET_MINUTES. AI, files and music are
# off on it. DEMO_SEED is an optional .board file it starts from.
# DEMO=1
# DEMO_RESET_MINUTES=60
# DEMO_SEED=data/demo.board

# --- Running it as a hosted service ---

# Let anyone create a tutor account.
# SIGNUPS=open

# This server's public address. Reset emails and Stripe link back to it.
# PUBLIC_URL=https://whiteboard.example.com

# Password-reset emails through Resend (https://resend.com). Without these,
# reset a password with `npm run tutor:password -w server -- <email>`.
# RESEND_API_KEY=
# RESEND_FROM=Whiteboard <noreply@example.com>

# The Pro plan through Stripe. With these set, AI is a Pro feature (the admin
# account always has it); without them, every tutor gets everything. All three
# are required once STRIPE_SECRET_KEY is set. Point a Stripe webhook at
# PUBLIC_URL/api/billing/webhook with the checkout.session.completed and
# customer.subscription.* events.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
