{
  "name": "server",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "migrate:ink": "tsx src/scripts/migrate-ink.ts",
    "migrate:shapes": "tsx src/scripts/migrate-ink.ts",
    "eval:agent": "node --env-file=.env --import tsx src/scripts/agent-eval.ts",
    "tutor:password": "tsx src/scripts/tutor-password.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.2.0",
    "@hono/node-server": "^2.0.11",
    "@whiteboard/shared": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "tsx": "^4.19.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.9"
  }
}
